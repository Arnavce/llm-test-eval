# Copy to .env (git-ignored) and fill in the provider you use.
# The pipeline also reads plain environment variables; those always win.
#
# Gemini (default provider for this study)
GEMINI_API_KEY=your-gemini-api-key-here
#
# Alternatives
# OPENAI_API_KEY=your-openai-key-here
# DEEPSEEK_API_KEY=your-deepseek-key-here
#
# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash
